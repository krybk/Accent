# Template only. The real .env is generated on the target server during
# bootstrap and is never committed — see .gitignore and scripts/check-secrets.sh.
#
# Every value below is a secret with a blast radius. GATEWAY_TOKEN in particular
# is the credential for everything the gateway forwards, the control plane
# included: treat it as seriously as any credential on the host.

# Bearer token the app presents on every request. Generated during bootstrap,
# handed to the app once, revocable by editing this file and restarting.
GATEWAY_TOKEN=replace-me-with-32-random-bytes

# Internal LiteLLM admin key. Never leaves the compose network.
LITELLM_MASTER_KEY=replace-me-with-32-random-bytes

POSTGRES_PASSWORD=replace-me-with-32-random-bytes

# Optional. Anthropic API key (console.anthropic.com), billed. It serves only
# /v1/chat through LiteLLM; the app's chat uses /v1/plane/chat and needs none.
ANTHROPIC_API_KEY=

# Set together with ANTHROPIC_API_KEY to start LiteLLM.
# COMPOSE_PROFILES=litellm

# Published port. 8443 rather than 443 so the stack does not collide with
# whatever else the server already serves.
GATEWAY_PORT=8443

# Host name or IP address the app connects to. Caddy names its site after it so
# the internal CA issues a leaf certificate for it. Bootstrap writes the real
# value; this placeholder only keeps `docker compose config` valid.
GATEWAY_HOST=127.0.0.1

# Optional. Host directory holding the control plane's unix socket; without a
# plane there, /v1/plane/* answers 404.
# PLANE_SOCKET_DIR=/run/accent-plane

# Optional. Directory of per-device token files: one file per app, holding
# sha256:<hex> of that app's token. Delete a file to revoke that app alone.
# GATEWAY_TOKENS_DIR=/var/lib/accent/tokens.d
