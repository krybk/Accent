# This repository is public. Anything below, once it lands in history, means a
# compromised server or signing key — not merely noise in a diff. The list is
# maintained together with scripts/check-secrets.sh: any new place where a
# secret could take root gets added to both at the same time.

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/*.key
*.jks
*.keystore
authorized_keys
id_ed25519*
id_rsa*

# State of a deployed gateway: generated on the target server, never here
gateway/data/
gateway/caddy/data/
gateway/caddy/config/

# Build output
node_modules/
.dart_tool/
build/
app/android/.gradle/
app/android/local.properties
*.apk
*.aab
# pubspec.lock is committed for apps and the gateway (reproducible builds) but
# not for the shared library package, per Dart convention.
protocol/pubspec.lock

# Tooling
.DS_Store
*.log
.vscode/
.idea/
